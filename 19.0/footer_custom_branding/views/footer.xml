<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="footer_rebranding"
              inherit_id="website.layout"
              name="Custom Footer Branding">

        <xpath expr="//footer//div[contains(@class, 'o_footer_copyright')]"
               position="replace">

            <!-- Check against 'True' string because get_param returns a string -->
            <t t-if="request.env['ir.config_parameter'].sudo().get_param('footer_branding_enabled') == 'True'">
                <div class="o_footer_copyright text-end w-100 py-2">
                    <div class="container">
                        <small class="text-muted fst-italic">
                            <span t-esc="request.env['ir.config_parameter'].sudo().get_param('footer_branding_text') or 'Powered by Company'"/>
                        </small>
                    </div>
                </div>
            </t>
            <!-- Fallback to empty div to maintain layout integrity if disabled -->
            <t t-else="">
                <div class="o_footer_copyright text-center"/>
            </t>

        </xpath>
    </template>
</odoo>