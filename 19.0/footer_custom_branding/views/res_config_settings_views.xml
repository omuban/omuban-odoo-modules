<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_footer_branding" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.footer.branding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" 
                     data-string="Footer Branding" 
                     string="Footer Branding" 
                     data-key="footer_branding_omuban">

                    <h2 class="mt-2">Website Footer Branding</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="footer_branding_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="footer_branding_enabled" string="Enable Branding"/>
                                <div class="text-muted">
                                    Replace the default 'Powered by Odoo' with custom text.
                                </div>
                                
                                <div class="mt-2" invisible="not footer_branding_enabled">
                                    <label for="footer_branding_text" string="Footer Text" class="fw-bold"/>
                                    <field name="footer_branding_text" placeholder="e.g. Powered by Omuban"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>