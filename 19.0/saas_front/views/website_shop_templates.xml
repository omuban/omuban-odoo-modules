<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. CSS Assets: Optimasi Tipografi & Shadow -->
    <template id="saas_shop_assets" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <style>
                .saas-pricing-card {
                    transition: all 0.3s ease;
                    border: none !important;
                    border-radius: 20px !important;
                    overflow: hidden;
                }
                .saas-pricing-card:hover {
                    transform: translateY(-10px);
                    box-shadow: 0 1.5rem 4rem rgba(0,0,0,.15) !important;
                }
                .saas-category-title {
                    font-weight: 800;
                    color: #1a2a3a;
                    text-transform: uppercase;
                    margin-top: 4rem;
                    text-align: center;
                }
                .saas-hr {
                    border-top: 3px solid #ebeef2;
                    width: 60px;
                    margin: 1rem auto 3rem auto;
                }
                
                /* Responsif Harga untuk PC/Laptop */
                .pricing-card-title {
                    font-weight: 800;
                    color: #0d6efd;
                    /* Gunakan clamp agar font mengecil otomatis jika layar sempit */
                    font-size: clamp(1.8rem, 4vw, 2.8rem); 
                    letter-spacing: -1px;
                }

                /* Mengecilkan Desimal (.00) dan Simbol Mata Uang */
                .pricing-card-title .oe_currency_value {
                    font-size: 100%;
                }
                .pricing-card-title .text-muted {
                    font-size: 0.9rem !important;
                }

                /* Sembunyikan Gambar & Produk Non-SaaS */
                .oe_product_image, .o_wsale_products_grid_table_wrapper { 
                    display: none !important; 
                }
            </style>
        </xpath>
    </template>

    <!-- 2. Override Main Shop Layout: Hanya Tampilkan SaaS -->
    <template id="products_saas_grouping" inherit_id="website_sale.products">
        <xpath expr="//div[@id='products_grid']" position="replace">
            <div id="products_grid" class="col">
                <t t-if="products">
                    <div class="container pb-5">
                        <!-- Filter: Hanya produk SaaS yang Published -->
                        <t t-set="saas_products"
                            t-value="products.filtered(lambda p: p.is_saas_pkg and p.is_published)" />
                        <t t-set="all_categories"
                            t-value="saas_products.mapped('public_categ_ids').sorted('sequence')" />

                        <t t-foreach="all_categories" t-as="categ">
                            <div class="row">
                                <div class="col-12">
                                    <h2 class="saas-category-title" t-esc="categ.name" />
                                    <div class="saas-hr" />
                                </div>
                            </div>
                            <div class="row justify-content-center g-4">
                                <t
                                    t-foreach="saas_products.filtered(lambda p: categ in p.public_categ_ids).sorted('website_sequence')"
                                    t-as="product">
                                    <div class="col-lg-4 col-md-6">
                                        <t t-call="saas_front.saas_pricing_card_template" />
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center mt-5">
                        <h3 class="text-muted">Belum ada paket yang tersedia saat ini.</h3>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <!-- 3. Template Kartu Pricing: Express Checkout & Price Fix -->
    <template id="saas_pricing_card_template">
        <div class="card h-100 saas-pricing-card shadow-sm border-0">
            <!-- Header Kartu -->
            <div
                t-attf-class="card-header py-4 text-center #{'bg-primary text-white' if product.website_sequence &lt; 10 else 'bg-light text-dark'}"
                style="border-radius: 20px 20px 0 0; border:none;">
                <h4 class="my-0 fw-bold" t-field="product.name" />
            </div>

            <div class="card-body d-flex flex-column p-4">
                <!-- Harga dengan Penanganan Desimal -->
                <div class="text-center mb-4">
                    <h2 class="pricing-card-title mb-0">
                        <span t-field="product.list_price"
                            t-options="{'widget': 'monetary', 'display_currency': product.currency_id}" />
                    </h2>
                    <div class="text-muted fw-bold mt-1"> Per <t t-esc="product.saas_duration" />
                        Hari </div>
                </div>

                <!-- Fitur List -->
                <ul class="list-unstyled mt-2 mb-4 flex-grow-1">
                    <li class="mb-3 d-flex align-items-center">
                        <div class="rounded-circle bg-primary-light p-2 me-2">
                            <i class="fa fa-users text-primary" />
                        </div>
                        <strong>Kapasitas: <t t-esc="product.saas_max_users" /> Users</strong>
                    </li>

                    <li class="text-muted small mb-2 mt-4 fw-bold">🚀 BISNIS</li>
                    <li class="small mb-2"><i class="fa fa-check-circle text-success me-2" />
                        Presensi HP, GPS &amp; Foto</li>
                    <li class="small mb-2"><i class="fa fa-check-circle text-success me-2" /> Rekap
                        Otomatis Payroll</li>
                    <li class="small mb-2"><i class="fa fa-check-circle text-success me-2" />
                        Laporan Harian/Mingguan</li>

                    <li class="text-muted small mb-2 mt-4 fw-bold">⚙️ TEKNIS</li>
                    <li class="small mb-2"><i class="fa fa-check-circle text-success me-2" /> PWA
                        (Tanpa Instal)</li>
                    <li class="small mb-2"><i class="fa fa-check-circle text-success me-2" /> Multi
                        Cabang &amp; Cloud</li>
                </ul>

                <!-- Tombol Pilih Paket: Langsung ke Cart -->
                <form action="/shop/cart/update" method="POST" class="mt-auto">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <input type="hidden" name="product_id"
                        t-att-value="product.product_variant_id.id" />
                    <!-- Express Checkout: Langsung ke halaman Cart -->
                    <input type="hidden" name="express" value="1" />
                    <button type="submit"
                        class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm"> Pilih
                        Paket <i class="fa fa-chevron-right ms-2 small" />
                    </button>
                </form>
            </div>
        </div>
    </template>
</odoo>