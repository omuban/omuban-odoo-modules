<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_saas_wallet_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.saas.wallet.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="alert alert-info t-0 mb-0" role="alert" invisible="not wallet_balance">
                    Saldo Wallet: <strong>
                        <field name="wallet_balance" />
                    </strong>
                </div>
            </xpath>
        </field>
    </record>
</odoo>