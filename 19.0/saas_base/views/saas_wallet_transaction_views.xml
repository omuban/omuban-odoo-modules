<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="saas_wallet_transaction_view_tree" model="ir.ui.view">
        <field name="name">saas.wallet.transaction.view.tree</field>
        <field name="model">saas.wallet.transaction</field>
        <field name="arch" type="xml">
            <list string="Wallet Transactions" create="false" edit="false">
                <field name="create_date" string="Date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="transaction_type" widget="badge" 
                       decoration-success="transaction_type == 'in'" 
                       decoration-info="transaction_type == 'bonus'" 
                       decoration-danger="transaction_type == 'out'"/>
                <field name="amount" sum="Total Amount"/>
                <field name="description"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_saas_wallet_transaction" model="ir.actions.act_window">
        <field name="name">Wallet History</field>
        <field name="res_model">saas.wallet.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Riwayat Wallet di bawah Sales -->
    <menuitem id="menu_saas_wallet_root" name="SaaS Wallet" parent="sale.menu_sale_config" sequence="100"/>
    <menuitem id="menu_saas_wallet_history" name="Wallet Transactions" parent="menu_saas_wallet_root" action="action_saas_wallet_transaction"/>
</odoo>