<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_saas_inherit" model="ir.ui.view">
        <field name="name">res.company.form.saas.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SaaS Subscription" name="saas_info">
                    <group>
                        <group string="Status &amp; Validity">
                            <field name="saas_status" widget="radio" options="{'horizontal': True}" />
                            <field name="expiry_date" />
                            <field name="saas_app_code" />
                        </group>
                        <group string="Quota">
                            <field name="max_users" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>