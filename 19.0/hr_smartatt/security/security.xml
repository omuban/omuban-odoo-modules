<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Kategori Modul (Tidak berubah) -->
    <record id="module_category_smart_attendance" model="ir.module.category">
        <field name="name">Smart Attendances</field>
        <field name="description">User access levels for the Smart Attendances module</field>
        <field name="sequence">25</field>
    </record>

    <!-- 2. Privilege sebagai Sub-header (Tidak berubah) -->
    <record id="privilege_smart_attendance" model="res.groups.privilege">
        <field name="name">Smart Attendance Access</field>
        <field name="category_id" ref="module_category_smart_attendance"/>
        <field name="sequence">1</field>
    </record>

    <!-- 3. Grup Keamanan: Officer -->
    <!-- Grup ini menjadi dasar. Pengguna biasa. -->
    <record id="group_smart_attendance_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_smart_attendance"/>
        <!-- Mewarisi hak akses dari grup 'Officer' bawaan Odoo untuk absensi -->
        <field name="implied_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
    </record>

    <!-- 4. Grup Keamanan: Administrator -->
    <!-- Grup ini memiliki hak akses lebih tinggi. -->
    <record id="group_smart_attendance_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_smart_attendance"/>
        <!-- 
            PENTING: Administrator secara otomatis menjadi Officer juga.
            Ini berarti Administrator mewarisi semua hak akses dari Officer.
        -->
        <field name="implied_ids" eval="[(4, ref('group_smart_attendance_officer'))]"/>
    </record>
    
</odoo>