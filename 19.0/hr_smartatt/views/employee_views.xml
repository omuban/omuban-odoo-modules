<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 1. CUSTOM LIST VIEW (TREE) -->
        <record id="view_employee_smart_attendance_list" model="ir.ui.view">
            <field name="name">hr.employee.smart.attendance.list</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <!-- Gunakan tag <list> untuk Odoo 19 -->
                <list string="Employees" 
                      decoration-success="attendance_state == 'checked_in'" 
                      decoration-muted="attendance_state == 'checked_out'">
                    
                    <field name="name"/>
                    <field name="work_email" optional="show"/>
                    <field name="department_id" optional="show"/>
                    <field name="job_title" optional="hide"/>
                    <field name="resource_calendar_id" string="Working Schedule" optional="show"/>
                    
                    <!-- Kolom Khusus Attendance -->
                    <field name="last_check_in" widget="datetime"/>
                    <field name="attendance_state" 
                           widget="badge" 
                           decoration-success="attendance_state == 'checked_in'" 
                           decoration-muted="attendance_state == 'checked_out'"/>
                </list>
            </field>
        </record>

        <!-- 2. CUSTOM KANBAN VIEW -->
        <record id="view_employee_smart_attendance_kanban" model="ir.ui.view">
            <field name="name">hr.employee.smart.attendance.kanban</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="job_title"/>
                    <field name="image_128"/>
                    <field name="attendance_state"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex">
                                <!-- Foto Karyawan -->
                                <div class="me-2">
                                    <field name="image_128" widget="image" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;"/>
                                </div>
                                <!-- Info Karyawan -->
                                <div class="flex-grow-1">
                                    <div class="fw-bold fs-5">
                                        <field name="name"/>
                                    </div>
                                    <div class="text-muted small">
                                        <field name="job_title"/>
                                    </div>
                                    <!-- Indikator Status Kehadiran -->
                                    <div class="mt-1">
                                        <t t-if="record.attendance_state.raw_value == 'checked_in'">
                                            <span class="badge rounded-pill text-bg-success">
                                                <i class="fa fa-check-circle me-1"/> Present
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge rounded-pill text-bg-secondary">
                                                <i class="fa fa-circle-o me-1"/> Absent
                                            </span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- 3. CUSTOM FORM VIEW -->
        <!-- Kita inherit form standar tapi kita rapikan header attendance-nya -->
        <record id="view_employee_smart_attendance_form" model="ir.ui.view">
            <field name="name">hr.employee.smart.attendance.form</field>
            <field name="model">hr.employee</field>
            <field name="mode">primary</field> <!-- Mode Primary agar tidak menimpa view standar di modul lain -->
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <!-- Modifikasi Header untuk menonjolkan status attendance -->
                <xpath expr="//header" position="inside">
                   <!-- Tombol manual check in/out admin (bawaan hr_attendance biasanya sudah ada, kita pastikan muncul) -->
                </xpath>
                <xpath expr="//field[@name='resource_calendar_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='tz']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                 <xpath expr="//notebook/page[1]" position="before">
                    <page string="Attendance" name="page_smart_attendance">
                        
                        <!-- Group Schedule (Dipindahkan dari tab lain) -->
                        <group>
                            <group string="Working Schedule" name="group_attendance_schedule">
                                <field name="resource_calendar_id" required="1"/>
                                <field name="tz" required="1"/>
                            </group>
                            <group>
                                <!-- Space kosong atau info tambahan attendance jika ada -->
                            </group>
                        </group>

                        <separator string="Attendance History"/>
                        
                        <!-- List Attendance (History) -->
                        <!-- Mengambil dari relation One2many attendance_ids -->
                        <field name="attendance_ids" readonly="1">
                            <list string="Attendance History" default_order="check_in desc" decoration-danger="not check_out">
                                <field name="check_in"/>
                                <field name="check_out"/>
                                <field name="worked_hours" widget="float_time" sum="Total Hours"/>
                                <field name="work_location_id" optional="show"/>
                            </list>
                        </field>

                    </page>
                </xpath>
                <!-- Kita bisa sembunyikan tab yang tidak perlu untuk Attendance Officer jika mau -->
                <!-- Contoh: Menyembunyikan Tab Personal Information -->
                <!-- 
                <xpath expr="//page[@name='personal_information']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath> 
                -->
            </field>
        </record>

        <!-- 4. ACTION DEFINITION -->
        <record id="action_smart_attendance_employees" model="ir.actions.act_window">
            <field name="name">Employees</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="hr.view_employee_filter"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                No employees found.
              </p>
            </field>
            <!-- PENTING: Link-kan View khusus yang kita buat di atas ke Action ini -->
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_employee_smart_attendance_list')}),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_employee_smart_attendance_kanban')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_employee_smart_attendance_form')})
            ]"/>
        </record>

    </data>
</odoo>