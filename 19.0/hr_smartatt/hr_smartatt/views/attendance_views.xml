<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
    <!-- 1. Menambahkan "Work Location" ke List View (Tree) -->
    <record id="view_attendance_tree_inherit_smartatt" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit.smartatt</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="work_location_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- 2. Menambahkan "Work Location" ke Form View -->
    <record id="hr_attendance_view_form_inherit_smartatt" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.smartatt</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <!-- Menargetkan field employee_id pertama yang ditemukan -->
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="work_location_id"/>
            </xpath>
            <xpath expr="//group[@name='check_in_group']" position="after">
                <group string="Proof of Attendance">
                    <div class="o_employee_avatar ms-2 p-0">
                        <field name="attendance_proof_image" widget="image" class="m-0" />
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <!-- 3. Perluas Search View untuk Attendances (DIPERBAIKI & DIKONFIRMASI) -->
    <record id="view_attendance_filter_smartatt_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.filter.smartatt.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <!-- 
                TARGET YANG BENAR:
                Cari filter "My Attendances" yang memiliki name="myattendances" 
                dan tambahkan field dan filter baru kita setelahnya.
            -->
            <xpath expr="//filter[@name='myattendances']" position="after">
                <field name="work_location_id"/>
                <filter name="work_location" string="Work Location" context="{'group_by': 'work_location_id'}"/>
            </xpath>
        </field>
    </record>
    <record id="action_smart_attendance_attendances" model="ir.actions.act_window">
            <field name="name">Attendances</field>
            <field name="res_model">hr.attendance</field>
            <field name="view_mode">list,form</field>
             
            <field name="search_view_id" ref="view_attendance_filter_smartatt_inherit"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                No attendance records found. Let's create one!
              </p>
            </field>
        </record>
    </data>
</odoo>