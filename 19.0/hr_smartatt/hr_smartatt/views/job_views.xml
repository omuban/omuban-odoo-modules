<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View untuk HR Job Positions -->
        <record id="view_job_list_smartatt" model="ir.ui.view">
            <field name="name">hr.job.list.smartatt</field>
            <field name="model">hr.job</field>
            <field name="arch" type="xml">
                <list string="Job Positions">
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="no_of_employee" string="Current Employees"/>
                </list>
            </field>
        </record>

        <!-- Action untuk HR Job Positions -->
        <record id="action_smart_attendance_job_positions" model="ir.actions.act_window">
            <field name="name">Job Positions</field>
            <field name="res_model">hr.job</field>
            <field name="view_mode">list,form</field>
             <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_job_list_smartatt')})]"/>
        </record>
    </data>
</odoo>