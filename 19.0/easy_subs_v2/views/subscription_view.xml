<odoo>
    <record id="view_easy_subscription_tree" model="ir.ui.view">
        <field name="name">easy.subscription.list</field>
        <field name="model">easy.subscription</field>
        <field name="arch" type="xml">
            <list string="Pelanggan Aktif">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="end_date"/>
                <field name="state" widget="badge" decoration-success="state=='active'" decoration-danger="state=='expired'"/>
            </list>
        </field>
    </record>

    <record id="action_easy_subscription" model="ir.actions.act_window">
        <field name="name">Daftar Langganan</field>
        <field name="res_model">easy.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_easy_subs_root" name="Subscriptions" parent="sale.sale_menu_root" action="action_easy_subscription" sequence="20"/>
</odoo>