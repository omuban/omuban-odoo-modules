<odoo>
    <!-- HALAMAN 1: LIST PRODUK (PRICING) -->
    <template id="pricing_page_template" name="Pricing Plans">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="text-center mb-5">
                    <h1>Plans and Pricing</h1>
                    <p class="lead">No setup fees, no hidden costs, and fully GDPR-ready.</p>
                </div>
                
                <div class="row justify-content-center">
                    <t t-foreach="products" t-as="p">
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="card-header bg-primary text-white text-center py-4">
                                    <h3 class="my-0 font-weight-normal" t-field="p.name"/>
                                </div>
                                <div class="card-body text-center d-flex flex-column">
                                    <h2 class="card-title pricing-card-title">
                                        <span t-field="p.list_price" t-options='{"widget": "monetary", "display_currency": p.currency_id}'/>
                                        <small class="text-muted"> / <t t-esc="p.sub_duration_days"/> month</small>
                                    </h2>
                                    <div class="mt-3 mb-4" style="flex-grow: 1;">
                                        <p class="text-muted" t-field="p.description_sale"/>
                                    </div>
                                    <a t-att-href="'/subs/buy/%s' % p.id" class="btn btn-lg btn-block btn-outline-primary">
                                        Select
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- HALAMAN 2: UPLOAD BUKTI -->
    <template id="payment_upload_template" name="Upload Payment">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="card shadow">
                            <div class="card-header bg-warning text-white">
                                <h4 class="mb-0"><i class="fa fa-credit-card"/> Selesaikan Pembayaran</h4>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-muted">No. Order: <strong t-field="order.name"/></span>
                                    <span class="h4 text-primary mb-0" t-field="order.amount_total" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                </div>

                                <div class="alert alert-info">
                                    <t t-raw="bank_info"/>
                                </div>

                                <hr/>

                                <!-- Jika Sudah Upload -->
                                <t t-if="order.is_proof_uploaded">
                                    <div class="text-center py-5">
                                        <i class="fa fa-check-circle text-success fa-5x mb-3"/>
                                        <h3>Bukti Diterima!</h3>
                                        <p>Admin kami sedang melakukan verifikasi.</p>
                                        <a href="/my/subscriptions" class="btn btn-secondary mt-3">Lihat Langganan Saya</a>
                                    </div>
                                </t>

                                <!-- Jika Belum Upload -->
                                <t t-else="">
                                    <form action="/subs/upload_action" method="post" enctype="multipart/form-data">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="order_id" t-att-value="order.id"/>
                                        
                                        <div class="form-group">
                                            <label class="font-weight-bold">Upload Bukti Transfer:</label>
                                            <input type="file" name="proof_file" class="form-control-file border p-2 rounded" required="required" accept="image/*,application/pdf"/>
                                            <small class="form-text text-muted">Format: JPG, PNG, PDF.</small>
                                        </div>

                                        <button type="submit" class="btn btn-primary btn-lg btn-block mt-4">
                                            <i class="fa fa-upload"/> Konfirmasi Pembayaran
                                        </button>
                                    </form>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>