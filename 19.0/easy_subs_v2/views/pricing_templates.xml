<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pricing_page_clean" name="CleanPresence Pricing V2">
        <t t-call="website.layout">
            <style>
                :root { --cp-primary: #00A5BC; --cp-bg-light: #f8fbfc; }
                .wizard-slide, h1, h2, h3, h4, h5, h6, div, span, button, i, p, input { 
                    transform: none !important; animation: none !important; transition: none !important; 
                }
                .nav-pills .nav-link { border-radius: 50px !important; font-size: 0.85rem; padding: 10px 25px; color: #6c757d; border: 1px solid transparent; }
                .nav-pills .nav-link.active { background-color: var(--cp-primary) !important; font-weight: bold; color: white !important; }
                .currency-btn { background: white; border: 1px solid #dee2e6; border-radius: 50px; font-weight: 700; color: var(--cp-primary); padding: 8px 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
                .price-card { border-radius: 20px; border: none; box-shadow: 0 5px 25px rgba(0,0,0,0.08); }
                .price-val-display { font-size: 2.3rem; font-weight: 800; color: var(--cp-primary); white-space: nowrap; }
                .summary-card { background: #f9f9f9; border-radius: 24px; border: 1px solid #eee; height: 100%; position: sticky; top: 100px; }
                .price-card-wrapper { min-height: 160px; display: flex; flex-direction: column; justify-content: center; }
            </style>

            <!-- METADATA DATA SOURCE FOR JS -->
            <input type="hidden" id="js_data_setup_fee" t-att-value="setup_fee" />
            <input type="hidden" id="js_data_symbol"
                t-att-value="current_pricelist.currency_id.symbol" />

            <div id="saas_wizard" class="container mt-5 mb-5" style="max-width: 1100px;">
                <!-- PROGRESS and CURRENCY -->
                <div class="text-center mb-5">
                    <div style="max-width: 650px; margin: 0 auto;">
                        <ul
                            class="nav nav-pills nav-justified bg-white border rounded-pill p-1 shadow-sm">
                            <li class="nav-item">
                                <a class="nav-link active rounded-pill fw-bold" id="v2-st-1">1.
                                    Choose Plan</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded-pill text-muted py-2 disabled"
                                    id="v2-st-2">2. Config</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded-pill text-muted py-2 disabled"
                                    id="v2-st-3">3. Launch</a>
                            </li>
                        </ul>
                    </div>
                    <div class="dropdown mt-4">
                        <button
                            class="currency-btn dropdown-toggle border-0 shadow-sm text-uppercase"
                            type="button" data-bs-toggle="dropdown">
                            <i class="fa fa-globe me-2" />
                            <t t-esc="current_pricelist.currency_id.name" />
                        </button>
                        <ul class="dropdown-menu shadow border-0 text-center rounded-3">
                            <t t-foreach="pricelists" t-as="pl">
                                <li>
                                    <a class="dropdown-item py-2 fw-bold"
                                        t-attf-href="/shop/change_pricelist/{{pl.id}}?r=/pricing">
                                        <t t-esc="pl.currency_id.name" />
                                    </a>
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>

                <!-- SLIDE 1 -->
                <div id="v-slide1" class="wizard-slide">
                    <div class="text-center mb-5">
                        <h1 class="fw-bold h1">Pilih Paket Kapasitas</h1>
                        <div
                            class="d-flex justify-content-center align-items-center mt-3 small fw-bold">
                            <span class="text-muted">BULANAN</span>
                            <div class="form-check form-switch mx-3">
                                <input class="form-check-input shadow-none" type="checkbox"
                                    id="v2CycleToggle"
                                    style="width:55px;height:25px;cursor:pointer;" />
                            </div>
                            <span class="text-dark small fw-bold uppercase">Annual <span
                                    class="badge rounded-pill bg-success ms-1">SAVE 2 MONTHS</span></span>
                        </div>
                    </div>

                    <div class="row justify-content-center g-4 text-center">
                        <t t-foreach="plan_groups.values()" t-as="group">
                            <t t-if="group['monthly'] or group['yearly']">
                                <div class="col-md-5 mb-4">
                                    <div class="card price-card h-100 p-4 p-lg-5 shadow-lg">
                                        <h3 class="fw-bold text-primary mb-4 text-uppercase">
                                            <t
                                                t-esc="group['monthly'].plan_group_code if group['monthly'] else group['yearly'].plan_group_code" />
                                        </h3>
                                        <div class="price-card-wrapper">
                                            <div class="v2-m-box">
                                                <t t-if="group['monthly']">
                                                    <t t-set="prc_m"
                                                        t-value="current_pricelist._get_product_price(group['monthly'], 1.0)" />
                                                    <div class="price-val-display">
                                                        <span t-esc="prc_m"
                                                            t-options='{"widget": "monetary", "display_currency": current_pricelist.currency_id}' />
                                                    </div>
                                                    <p class="text-muted small mt-2">per bulan</p>
                                                    <button
                                                        class="btn btn-primary btn-lg w-100 py-3 rounded-pill mt-4 next-slide fw-bold shadow"
                                                        t-att-data-p-id="group['monthly'].id"
                                                        t-att-data-p-name="group['monthly'].plan_group_code"
                                                        t-att-data-p-price="prc_m"
                                                        t-att-data-p-dur="group['monthly'].sub_duration_days"
                                                        t-att-data-p-bill="'Monthly'"
                                                        data-next="v-slide2">Select Package</button>
                                                </t>
                                            </div>
                                            <div class="v2-y-box d-none">
                                                <t t-if="group['yearly']">
                                                    <t t-set="prc_y"
                                                        t-value="current_pricelist._get_product_price(group['yearly'], 1.0)" />
                                                    <div class="price-val-display text-success">
                                                        <span t-esc="prc_y"
                                                            t-options='{"widget": "monetary", "display_currency": current_pricelist.currency_id}' />
                                                    </div>
                                                    <p
                                                        class="text-muted small text-success fw-bold uppercase">Tagihan
                                                        Tahunan</p>
                                                    <button
                                                        class="btn btn-primary btn-lg w-100 py-3 rounded-pill mt-4 next-slide fw-bold shadow"
                                                        t-att-data-p-id="group['yearly'].id"
                                                        t-att-data-p-name="group['yearly'].plan_group_code"
                                                        t-att-data-p-price="prc_y"
                                                        t-att-data-p-dur="group['yearly'].sub_duration_days"
                                                        t-att-data-p-bill="'Yearly'"
                                                        data-next="v-slide2">Select Package</button>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>

                    <!-- TRIAL BANNER -->
                    <div class="row justify-content-center mt-5">
                        <t t-foreach="plan_groups.values()" t-as="group">
                            <t t-if="group['trial']">
                                <div class="col-md-10 text-start">
                                    <div
                                        class="card p-4 rounded-4 bg-white shadow-sm border-primary"
                                        style="border: 2px dashed var(--cp-primary) !important;">
                                        <div class="row align-items-center">
                                            <div class="col-lg-8 px-lg-4">
                                                <h4 class="fw-bold mb-1 text-dark"><i
                                                        class="fa fa-rocket text-primary me-2" />
                                                    Gratis Coba 7-Hari</h4>
                                                <p class="text-muted small mb-0">Nikmati akses
                                                    premium lengkap tanpa komitmen kartu kredit.</p>
                                            </div>
                                            <div class="col-lg-4 text-center mt-3 mt-lg-0">
                                                <button
                                                    class="btn btn-primary px-5 py-3 fw-bold rounded-pill next-slide shadow"
                                                    t-att-data-p-id="group['trial'].id"
                                                    t-att-data-p-name="'Free Trial'"
                                                    t-att-data-p-price="0" t-att-data-p-dur="7"
                                                    t-att-data-p-bill="'Trial'" data-next="v-slide2">Coba
                                                    Gratis</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>

                <!-- SLIDE 2: REVIEW -->
                <div id="v-slide2" class="wizard-slide d-none text-start">
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <div class="card p-5 border-0 shadow rounded-4 bg-white h-100">
                                <h3 class="fw-bold text-dark">Rangkuman Pesanan</h3>
                                <div
                                    class="p-4 rounded-4 border bg-light mt-4 shadow-sm d-flex justify-content-between align-items-center">
                                    <div>
                                        <h4 class="fw-bold text-primary mb-1" id="rev-disp-name">Plan
                                            Name</h4>
                                        <p class="text-muted small mb-0">Status: Konfigurasi
                                            berhasil.</p>
                                    </div>
                                    <div class="h3 fw-bold text-dark" id="rev-disp-price">0.00</div>
                                </div>
                                <div class="mt-4 pt-3">
                                    <h5 class="fw-bold small uppercase mb-3">MASA LAYANAN:</h5>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div
                                                class="p-3 border rounded-3 text-center bg-white shadow-sm small">
                                                Mulai: <strong>Hari Ini</strong></div>
                                        </div>
                                        <div class="col-md-6">
                                            <div
                                                class="p-3 border rounded-3 text-center bg-white shadow-sm small text-primary">
                                                Akhir: <strong id="rev-disp-date">---</strong></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-auto pt-5 border-top text-center">
                                    <button
                                        class="btn btn-primary btn-lg rounded-pill w-100 py-3 fw-bold shadow next-slide"
                                        data-next="v-slide3">KONFIRMASI DETAIL &amp; REGISTER</button>
                                    <button class="btn btn-link mt-2 text-muted prev-slide small"
                                        style="text-decoration:none" data-prev="v-slide1">
                                        <u>Ubah Paket Sebelumnya</u>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- BILLING SIDEBAR -->
                        <div class="col-lg-5">
                            <div class="card p-4 summary-card border-0 shadow">
                                <h5 class="fw-bold border-bottom pb-3 mb-4 text-dark">Rincian
                                    Billing</h5>
                                <div class="mb-4 small border-bottom pb-3">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>SaaS Selection:</span>
                                        <span class="fw-bold text-uppercase" id="sum-name">---</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span>Billing Cycle:</span>
                                        <span class="text-primary fw-bold" id="sum-bill">---</span>
                                    </div>
                                </div>
                                <div class="py-1 small text-dark mb-4 border-bottom pb-3">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Sewa Paket Inti</span>
                                        <span class="fw-bold" id="sum-base-p">0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span>Biaya Provisioning</span>
                                        <span class="fw-bold" id="sum-setup-p">0.00</span>
                                    </div>
                                </div>
                                <div
                                    class="border-top pt-4 mt-auto text-end bg-white rounded-4 p-3 border">
                                    <p class="text-muted small mb-0 fw-bold uppercase">GRAND TOTAL
                                        TAGIHAN:</p>
                                    <div
                                        class="h1 fw-bold text-dark d-flex justify-content-end align-items-center mt-1">
                                        <span id="sum-sym" class="me-2 fs-3 text-muted"></span>
                                        <!-- ID ini yang digunakan oleh JS -->
                                        <span id="sum-total-amt">0.00</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SLIDE 3: REGISTER -->
                <div id="v-slide3" class="wizard-slide d-none p-lg-5">
                    <div
                        class="card p-5 border-0 shadow-lg rounded-4 mx-auto bg-white text-start shadow-lg"
                        style="max-width: 600px;">
                        <h2 class="fw-bold text-center mb-5 text-dark h3 uppercase">Detail Hub</h2>
                        <label class="fw-bold small text-muted mb-1">Subdomain</label>
                        <div class="input-group input-group-lg border rounded-4 shadow-sm mb-4">
                            <input type="text" id="final_sub_val"
                                class="form-control border-0 px-3 bg-white" placeholder="lawhub-xyz" />
                            <span class="input-group-text bg-white border-0 fw-bold px-4 small">
                                .cleanpresence.com</span>
                        </div>
                        <label class="fw-bold small text-muted mb-1">Legal Company Name</label>
                        <input type="text" id="final_comp_val"
                            class="form-control form-control-lg border bg-light shadow-none mb-5 px-3 py-3"
                            placeholder="Organization Title Ltd." />
                        <button id="dev_trigger_btn"
                            class="btn btn-primary btn-lg w-100 py-4 fw-bold shadow shadow-lg rounded-pill uppercase">DAFTAR
                            DAN BUAT SEKARANG</button>
                    </div>
                </div>
            </div>

            <!-- ENGINE JS -->
            <script type="text/javascript">
            <![CDATA[
                document.addEventListener('DOMContentLoaded', function() {
                    const SYM = document.getElementById('js_data_symbol')?.value || 'Rp ';
                    const FIXED_SETUP = parseFloat(document.getElementById('js_data_setup_fee')?.value || 0);

                    let cart = { pid:0, name:'', price:0, dur:30, bill:'' };
                    const formatP = (n) => n.toLocaleString('id-ID', { minimumFractionDigits: 2 });
                    function putVal(id, t) { const el = document.getElementById(id); if(el) el.innerText = t; }

                    function refreshWizardPills(stepNum) {
                        for(let i=1; i<=3; i++) {
                            const p = document.getElementById('v2-st-'+i); if(!p) continue;
                            if(i === stepNum) { p.classList.add('active','fw-bold'); p.classList.remove('disabled','text-muted'); }
                            else { p.classList.remove('active','fw-bold'); if(i < stepNum) p.classList.remove('disabled'); else p.classList.add('disabled','text-muted'); }
                        }
                        window.scrollTo(0,0);
                    }

                    document.querySelectorAll('.next-slide').forEach(b => {
                        b.addEventListener('click', function() {
                            const nxtID = this.dataset.next;
                            if(nxtID === 'v-slide2' && (this.dataset.pId || this.getAttribute('data-p-id'))) {
                                cart = { 
                                    pid: parseInt(this.dataset.pId || this.getAttribute('data-p-id')),
                                    name: this.dataset.pName || this.getAttribute('data-p-name'),
                                    price: parseFloat(this.dataset.pPrice || this.getAttribute('data-p-price') || 0), 
                                    dur: parseInt(this.dataset.pDur || this.getAttribute('data-p-dur') || 30), 
                                    bill: this.dataset.pBill || this.getAttribute('data-p-bill') 
                                };

                                // Write to Main Review
                                putVal('rev-disp-name', cart.name);
                                putVal('rev-disp-price', SYM + ' ' + formatP(cart.price));
                                const now = new Date(); const end = new Date(); end.setDate(now.getDate() + cart.dur);
                                putVal('rev-disp-date', end.toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric'}));

                                // Write to Sidebar Review
                                putVal('sum-name', cart.name);
                                putVal('sum-bill', cart.bill);
                                putVal('sum-base-p', SYM + ' ' + formatP(cart.price));
                                putVal('sum-sym', SYM);

                                // CALCULATION LOGIC: Fix for 0 issues
                                const sFee = (cart.bill === 'Trial') ? 0 : FIXED_SETUP;
                                const grandT = cart.price + sFee;

                                putVal('sum-setup-p', SYM + ' ' + formatP(sFee));
                                putVal('sum-total-amt', formatP(grandT));
                            }
                            document.querySelectorAll('.wizard-slide').forEach(s => s.classList.add('d-none'));
                            document.getElementById(nxtID)?.classList.remove('d-none');
                            refreshWizardPills(parseInt(nxtID.slice(-1)));
                        });
                    });

                    document.querySelectorAll('.prev-slide').forEach(b => { 
                        b.onclick = () => { 
                            const target = b.dataset.prev || (cart.pid ? 'v-slide2' : 'v-slide1');
                            document.querySelectorAll('.wizard-slide').forEach(s => s.classList.add('d-none'));
                            document.getElementById(target).classList.remove('d-none');
                            refreshWizardPills(parseInt(target.slice(-1)));
                        }
                    });

                    document.getElementById('v2CycleToggle').onchange = function() {
                        const check = this.checked;
                        document.querySelectorAll('.v2-m-box').forEach(v => v.classList.toggle('d-none', check));
                        document.querySelectorAll('.v2-y-box').forEach(v => v.classList.toggle('d-none', !check));
                    }
                    
                    document.getElementById('dev_trigger_btn').onclick = () => {
                        alert("Provisioning Engine: Success data pickup for " + document.getElementById('final_sub_val').value);
                    }
                });
            ]]>
            </script>
        </t>
    </template>
</odoo>
